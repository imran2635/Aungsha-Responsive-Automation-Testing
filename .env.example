# Base URL for Aungsha staging
BASE_URL=https://staging.aungsha.com

# Run headless: true | false (default: true)
HEADLESS=true

# Optional slow motion in ms (headed debugging)
SLOW_MO=0

# Timeouts (ms)
DEFAULT_TIMEOUT=30000
EXPECT_TIMEOUT=10000
NAVIGATION_TIMEOUT=45000

# Retries (CI often uses 2; local can be 0)
RETRIES=1

# Workers — leave empty for Playwright default
# WORKERS=4

# Auth credentials for login tests (optional — validation tests skip if missing)
AUNGSHA_EMAIL=
AUNGSHA_PASSWORD=
